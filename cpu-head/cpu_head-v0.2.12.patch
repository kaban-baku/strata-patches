diff --git a/src/core/cpu_head.cpp b/src/core/cpu_head.cpp
new file mode 100644
index 0000000..65ddb4b
--- /dev/null
+++ b/src/core/cpu_head.cpp
@@ -0,0 +1,106 @@
+// cpu_head.cpp - see include/strata/core/cpu_head.hpp
+#include "strata/core/cpu_head.hpp"
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+namespace strata::core {
+
+namespace {
+using VecDot = ggml_vec_dot_t;
+constexpr int64_t kTile = 64;   // weight rows per inner step: every token's dot against a row while it is hot
+}
+
+CpuHead::~CpuHead() {
+    {
+        std::lock_guard<std::mutex> lk(mu_);
+        stop_ = true;
+        ++gen_;
+    }
+    cv_.notify_all();
+    for (auto& t : workers_)
+        if (t.joinable()) t.join();
+}
+
+bool CpuHead::init(int type, const void* w, int64_t n_in, int64_t n_out, int threads, std::string& err) {
+    ggml_cpu_init();
+    const ggml_type t = (ggml_type) type;
+    const ggml_type_traits_cpu* tc = ggml_get_type_traits_cpu(t);
+    if (tc == nullptr || tc->vec_dot == nullptr) { err = "cpu head: no CPU dot product for head type " + std::to_string(type); return false; }
+    const ggml_type vt = tc->vec_dot_type;
+    const ggml_type_traits_cpu* vtc = ggml_get_type_traits_cpu(vt);
+    if (vt != GGML_TYPE_F32 && (vtc == nullptr || vtc->from_float == nullptr)) { err = "cpu head: no quantizer for the activation type"; return false; }
+    if (n_in % ggml_blck_size(t) != 0 || n_in % ggml_blck_size(vt) != 0) { err = "cpu head: the head width is not a whole number of blocks"; return false; }
+    type_ = type;
+    w_ = (const uint8_t*) w;
+    n_in_ = n_in;
+    n_out_ = n_out;
+    row_bytes_ = ggml_row_size(t, n_in);
+    vec_dot_type_ = (int) vt;
+    xq_row_bytes_ = ggml_row_size(vt, n_in);
+    vec_dot_ = (void*) tc->vec_dot;
+    xq_.assign(xq_row_bytes_ * 16 + 64, 0);
+    threads = std::max(1, std::min(threads, 64));
+    n_parts_ = threads;
+    for (int i = 1; i < threads; ++i) workers_.emplace_back([this, i] { work(i); });
+    return true;
+}
+
+void CpuHead::run_part(int idx) {
+    const VecDot dot = (VecDot) vec_dot_;
+    // parts are contiguous row ranges, cut on tile edges
+    const int64_t tiles = (n_out_ + kTile - 1) / kTile;
+    const int64_t t0 = tiles * idx / n_parts_, t1 = tiles * (idx + 1) / n_parts_;
+    const int64_t r0 = t0 * kTile, r1 = std::min<int64_t>(t1 * kTile, n_out_);
+    const int R = rows_;
+    for (int64_t r = r0; r < r1; ++r) {
+        const uint8_t* wr = w_ + (size_t) r * row_bytes_;
+        for (int t = 0; t < R; ++t) {
+            float s = 0.0f;
+            dot((int) n_in_, &s, 0, wr, 0, xq_.data() + (size_t) t * xq_row_bytes_, 0, 1);
+            logits_[(size_t) t * (size_t) n_out_ + (size_t) r] = s;
+        }
+    }
+}
+
+void CpuHead::work(int idx) {
+    uint64_t seen = 0;
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> lk(mu_);
+            cv_.wait(lk, [&] { return gen_ != seen; });
+            seen = gen_;
+            if (stop_) return;
+        }
+        run_part(idx);
+        pending_.fetch_sub(1, std::memory_order_acq_rel);
+    }
+}
+
+void CpuHead::compute(const float* x, int rows, float* logits) {
+    const auto c0 = std::chrono::steady_clock::now();
+    if (rows > 16) rows = 16;
+    const ggml_type vt = (ggml_type) vec_dot_type_;
+    for (int t = 0; t < rows; ++t) {
+        uint8_t* dst = xq_.data() + (size_t) t * xq_row_bytes_;
+        if (vt == GGML_TYPE_F32) std::memcpy(dst, x + (size_t) t * n_in_, (size_t) n_in_ * 4);
+        else ggml_get_type_traits_cpu(vt)->from_float(x + (size_t) t * n_in_, dst, n_in_);
+    }
+    rows_ = rows;
+    logits_ = logits;
+    pending_.store(n_parts_ - 1, std::memory_order_release);
+    {
+        std::lock_guard<std::mutex> lk(mu_);
+        ++gen_;
+    }
+    cv_.notify_all();
+    run_part(0);
+    while (pending_.load(std::memory_order_acquire) != 0) std::this_thread::yield();
+    last_ms_ = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - c0).count();
+}
+
+}  // namespace strata::core
