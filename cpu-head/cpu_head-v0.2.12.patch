index 0000000..bd6d70e
--- /dev/null
+++ b/include/strata/core/cpu_head.hpp
@@ -0,0 +1,57 @@
+#pragma once
+// cpu_head: the output head computed by the CPU from the pinned host copy of output.weight (a local experiment,
+// 2026-11-08).  On a card that cannot keep the head in VRAM the engine reads it over PCIe for every logits row
+// (~42 ms per row for a 497 MiB Q6_K head at ~12 GB/s on an RTX 3070 Ti Laptop); the CPU reads the same bytes from
+// RAM (~47 GB/s with 8 threads on a Ryzen 7 6800H), so the verify window rings the host once more after the last
+// layer and the host writes the logits into mapped memory (STRATA_CPU_HEAD=1).
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace strata::core {
+
+class CpuHead {
+public:
+    CpuHead() = default;
+    ~CpuHead();
+    CpuHead(const CpuHead&) = delete;
+    CpuHead& operator=(const CpuHead&) = delete;
+
+    // w: the ggml-layout head [n_out rows][n_in] of ggml type `type`, in host memory
+    bool init(int type, const void* w, int64_t n_in, int64_t n_out, int threads, std::string& err);
+    // x: rows x n_in floats; logits: rows x n_out floats (row-major, a row per token)
+    void compute(const float* x, int rows, float* logits);
+    int threads() const { return (int) workers_.size() + 1; }
+    double last_ms() const { return last_ms_; }
+
+private:
+    void work(int idx);
+    void run_part(int idx);
+
+    int type_ = -1;
+    const uint8_t* w_ = nullptr;
+    int64_t n_in_ = 0, n_out_ = 0;
+    size_t row_bytes_ = 0, xq_row_bytes_ = 0;
+    int vec_dot_type_ = -1;
+    void* vec_dot_ = nullptr;
+    std::vector<uint8_t> xq_;
+    // the job
+    int rows_ = 0;
+    float* logits_ = nullptr;
+    int n_parts_ = 1;
+    // the pool: workers 1..n-1 wait for a new generation; the caller is part 0
+    std::vector<std::thread> workers_;
+    std::mutex mu_;
+    std::condition_variable cv_;
+    uint64_t gen_ = 0;
+    std::atomic<int> pending_{0};
+    bool stop_ = false;
+    double last_ms_ = 0.0;
+};
+
+}  // namespace strata::core
