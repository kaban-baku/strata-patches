diff --git a/src/kernels/route_bias_ne_parity.cu b/src/kernels/route_bias_ne_parity.cu
new file mode 100644
index 00000000..a75e72ea
--- /dev/null
+++ b/src/kernels/route_bias_ne_parity.cu
@@ -0,0 +1,135 @@
+// STRATA_ROUTE_PRIOR and STRATA_ROUTE_RESIDENT against CPU reference routing for 256, 384 and 512 experts.
+#include "strata/kernels/native_router.hpp"
+#include "strata/kernels/route_prior.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+namespace {
+constexpr int kTop = 10;
+constexpr int kTokens = 3;
+
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) { std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e)); std::exit(2); }
+}
+
+void weights_for(const float* logits, const int32_t* ids, float* weights) {
+    float mx = -INFINITY;
+    for (int r = 0; r < kTop; ++r) mx = std::max(mx, logits[ids[r]]);
+    float sum = 0.0f;
+    for (int r = 0; r < kTop; ++r) { weights[r] = std::exp(logits[ids[r]] - mx); sum += weights[r]; }
+    for (int r = 0; r < kTop; ++r) weights[r] /= sum;
+}
+
+void prior_ref(const float* logits, const int32_t* res, int ne, float bias, int32_t* ids, float* weights) {
+    for (int r = 0; r < kTop; ++r) {
+        float best = -INFINITY;
+        int chosen = -1;
+        for (int e = 0; e < ne; ++e) {
+            bool used = false;
+            for (int q = 0; q < r; ++q) used |= ids[q] == e;
+            if (used) continue;
+            const float score = logits[e] + (res[e] >= 0 ? bias : 0.0f);
+            if (score > best) { best = score; chosen = e; }
+        }
+        ids[r] = chosen;
+    }
+    weights_for(logits, ids, weights);
+}
+
+void resident_ref(const float* logits, const int32_t* res, int ne, float margin, int32_t* ids, float* weights) {
+    bool swapped = false;
+    for (int r = 6; r < kTop; ++r) {
+        if (res[ids[r]] >= 0) continue;
+        float best = -INFINITY;
+        int chosen = -1;
+        for (int e = 0; e < ne; ++e) {
+            if (res[e] < 0) continue;
+            bool used = false;
+            for (int q = 0; q < kTop; ++q) used |= ids[q] == e;
+            if (used) continue;
+            if (logits[e] > best) { best = logits[e]; chosen = e; }
+        }
+        if (chosen >= 0 && logits[ids[r]] - best <= margin) { ids[r] = chosen; swapped = true; }
+    }
+    if (swapped) weights_for(logits, ids, weights);
+}
+
+bool same(const std::vector<int32_t>& ids, const std::vector<int32_t>& expected,
+          const std::vector<float>& weights, const std::vector<float>& expected_weights) {
+    if (ids != expected) return false;
+    for (size_t i = 0; i < weights.size(); ++i)
+        if (std::fabs(weights[i] - expected_weights[i]) > 2e-5f) return false;
+    return true;
+}
+}  // namespace
+
+int main() {
+    std::mt19937 rng(20261105u);
+    std::uniform_real_distribution<float> logits_rng(-3.0f, 3.0f);
+    std::uniform_int_distribution<int> resident_rng(0, 1);
+    cudaStream_t stream = nullptr;
+    ck(cudaStreamCreate(&stream), "stream");
+    float* d_logits = nullptr;
+    float* d_weights = nullptr;
+    int32_t* d_res = nullptr;
+    int32_t* d_ids = nullptr;
+    ck(cudaMalloc(&d_logits, kTokens * 512 * sizeof(float)), "logits");
+    ck(cudaMalloc(&d_weights, kTokens * kTop * sizeof(float)), "weights");
+    ck(cudaMalloc(&d_res, 512 * sizeof(int32_t)), "residency");
+    ck(cudaMalloc(&d_ids, kTokens * kTop * sizeof(int32_t)), "ids");
+
+    int bad = 0;
+    for (int ne : {256, 384, 512}) {
+        std::vector<float> logits((size_t) kTokens * ne), weights(kTokens * kTop), expected_weights(weights.size());
+        std::vector<int32_t> res(ne), ids(kTokens * kTop), expected(ids.size());
+        for (int c = 0; c < 20; ++c) {
+            for (float& v : logits) v = logits_rng(rng);
+            for (int32_t& v : res) v = resident_rng(rng) ? 0 : -1;
+            ck(cudaMemcpy(d_logits, logits.data(), logits.size() * sizeof(float), cudaMemcpyHostToDevice), "up logits");
+            ck(cudaMemcpy(d_res, res.data(), res.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up residency");
+            for (float bias : {0.0f, 1.5f}) {
+                for (int t = 0; t < kTokens; ++t)
+                    prior_ref(logits.data() + (size_t) t * ne, res.data(), ne, bias,
+                              expected.data() + t * kTop, expected_weights.data() + t * kTop);
+                strata::kernels::route_prior_top10(d_logits, d_res, bias, d_ids, d_weights, kTokens, ne, stream);
+                ck(cudaStreamSynchronize(stream), "prior");
+                ck(cudaMemcpy(ids.data(), d_ids, ids.size() * sizeof(int32_t), cudaMemcpyDeviceToHost), "down prior ids");
+                ck(cudaMemcpy(weights.data(), d_weights, weights.size() * sizeof(float), cudaMemcpyDeviceToHost), "down prior weights");
+                if (!same(ids, expected, weights, expected_weights)) {
+                    std::fprintf(stderr, "route prior: ne=%d case=%d bias=%g differs\n", ne, c, bias);
+                    ++bad;
+                }
+
+                for (int t = 0; t < kTokens; ++t)
+                    prior_ref(logits.data() + (size_t) t * ne, res.data(), ne, 0.0f,
+                              expected.data() + t * kTop, expected_weights.data() + t * kTop);
+                ck(cudaMemcpy(d_ids, expected.data(), expected.size() * sizeof(int32_t), cudaMemcpyHostToDevice), "up resident ids");
+                ck(cudaMemcpy(d_weights, expected_weights.data(), expected_weights.size() * sizeof(float), cudaMemcpyHostToDevice), "up resident weights");
+                for (int t = 0; t < kTokens; ++t)
+                    resident_ref(logits.data() + (size_t) t * ne, res.data(), ne, bias,
+                                 expected.data() + t * kTop, expected_weights.data() + t * kTop);
+                strata::kernels::native_route_resident(d_logits, d_ids, d_weights, d_res, kTokens, bias, 6, 9, ne,
+                                                       nullptr, stream);
+                ck(cudaStreamSynchronize(stream), "resident");
+                ck(cudaMemcpy(ids.data(), d_ids, ids.size() * sizeof(int32_t), cudaMemcpyDeviceToHost), "down resident ids");
+                ck(cudaMemcpy(weights.data(), d_weights, weights.size() * sizeof(float), cudaMemcpyDeviceToHost), "down resident weights");
+                if (!same(ids, expected, weights, expected_weights)) {
+                    std::fprintf(stderr, "route resident: ne=%d case=%d margin=%g differs\n", ne, c, bias);
+                    ++bad;
+                }
+            }
+        }
+    }
+    cudaFree(d_logits); cudaFree(d_weights); cudaFree(d_res); cudaFree(d_ids);
+    cudaStreamDestroy(stream);
+    std::printf("route_bias_ne_parity: %s\n", bad ? "FAIL" : "OK");
+    return bad ? 1 : 0;
+}
